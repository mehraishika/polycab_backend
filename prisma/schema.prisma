  @@unique([sno, dayDate, timestamp])
  @@index([dayDate])
  @@index([sno, timestamp])
  @@index([sno, dayDate])
  @@map("device_daily_summary_per_line_chart")
}

model information_data {
  id               BigInt   @id @default(autoincrement())
  input_power      Float?   @map("Input Power")
  co2              Float?
  tree_planting    Float?   @map("Tree Planting")
  efficiency       Float?
  weather          String?
  irradiance       Float?
  cell_temperature Float?
  plantid          BigInt
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt
  plant            Plant    @relation(fields: [plantid], references: [id])

  @@index([plantid])
  @@map("information_data")
}

model DeviceConnectionStatus {
  id           BigInt    @id @default(autoincrement())
  serialNumber String?   @map("serial_number") @db.VarChar(255)
  macAddress   String    @unique @map("mac_address") @db.VarChar(255)
  status       String    @db.VarChar(50)
  lastSeenTime DateTime? @map("lastSeenTime") @db.Timestamptz(6)

  @@index([status], map: "idx_device_connection_status_status")
  @@map("device_connection_status")
}

model fota {
  id          Int     @unique @default(autoincrement())
  mac_address String  @id @db.VarChar(50)
  firmware    String? @db.VarChar(50)
  link        String? @db.VarChar(255)

  @@map("fota")
}

model DeviceCurrentStatus {
  id                BigInt      @id @default(autoincrement())
  sno               String      @unique
  status            PlantStatus @default(Offline)
  lastTelemetryAt   DateTime?   @map("last_telemetry_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  @@index([status])
  @@index([lastTelemetryAt])

  @@map("device_current_status")
}

model DeviceStatusHistory {
  id         BigInt      @id @default(autoincrement())
  sno        String
  plantId    BigInt?     @map("plant_id")
  status     PlantStatus
  createdAt  DateTime    @default(now()) @map("created_at")

  @@index([sno])
  @@index([plantId])
  @@index([status])

  @@map("device_status_history")
}

model PlantCurrentStatus {
  id              BigInt      @id @default(autoincrement())
  plantId         BigInt      @unique @map("plant_id")

  status          PlantStatus @default(Offline)

  totalDevices    Int         @default(0) @map("total_devices")
  normalCount     Int         @default(0) @map("normal_count")
  abnormalCount   Int         @default(0) @map("abnormal_count")
  standbyCount    Int         @default(0) @map("standby_count")
  offlineCount    Int         @default(0) @map("offline_count")

  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  plant           Plant       @relation(fields: [plantId], references: [id])

  @@index([status])
  @@map("plant_current_status")
}

model DeviceAlertState {

  id                BigInt      @id @default(autoincrement())
  serialNumber      String      @unique @map("serial_number")
  plantId           BigInt?     @map("plant_id")
  plant             Plant?      @relation(fields: [plantId], references: [id])
  alertMatrix       Json        @map("alert_matrix")
  activeAlertCount  Int         @default(0) @map("active_alert_count")
  lastTelemetryAt   DateTime    @map("last_telemetry_at")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")
  @@index([serialNumber])
  @@index([plantId])
  @@map("device_alert_state")
}

model AlertEvent {

  id               BigInt       @id @default(autoincrement())
  serialNumber     String       @map("serial_number")
  plantId          BigInt?      @map("plant_id")
  plant            Plant?       @relation(fields: [plantId], references: [id])
  registerNo       Int          @map("register_no")
  bitPosition      Int          @map("bit_position")
  faultCode        String       @map("fault_code")
  faultMessage     String       @map("fault_message")
  status           AlertStatus
  raisedAt         DateTime?     @map("raised_at")
  clearedAt        DateTime?    @map("cleared_at")
  createdAt        DateTime     @default(now()) @map("created_at")
  @@index([serialNumber])
  @@index([plantId])
  @@index([status])
  @@map("alert_events")
}

model FaultDictionary {

  id             BigInt   @id @default(autoincrement())
  registerName   String   @map("register_name")      // ErrorCode1
  registerAddr   String   @map("register_addr")      // 0x101E
  registerNo     Int      @map("register_no")        // 1..6 (your matrix index)
  bitPosition    Int      @map("bit_position")
  faultCode      String   @map("fault_code")
  faultMessage   String   @map("fault_message")
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([registerNo, bitPosition])
  @@map("fault_dictionary")
}

model RemoteSettingParameterMaster {
  id                BigInt   @id @default(autoincrement())
  tab               String   @db.VarChar(40)
  tabLabel          String   @map("tab_label") @db.VarChar(60)
  fieldKey          String   @map("field_key") @db.VarChar(60)
  label             String   @db.VarChar(150)
  dataType          String   @map("data_type") @db.VarChar(20)
  unitOrOptions     String?  @map("unit_or_options") @db.VarChar(200)
  endpointPath      String   @map("endpoint_path") @db.VarChar(120)
  displayOrder      Int      @map("display_order")
  count             Int      @default(1)
  registerAddress   String?  @map("register_address") @db.VarChar(20)
  registerType      String?  @map("register_type") @db.VarChar(20)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tab, fieldKey], map: "remote_setting_parameter_master_tab_field_key_key")
  @@index([tab], map: "remote_setting_parameter_master_tab_idx")
  @@map("remote_setting_parameter_master")
}

model RemoteSettingCommandMaster {
  id               BigInt   @id @default(autoincrement())
  commandKey       String   @unique @map("command_key") @db.VarChar(60)
  label            String   @db.VarChar(150)
  endpointPath     String   @default("/remote-settings/command") @map("endpoint_path") @db.VarChar(120)
  displayOrder     Int      @map("display_order")
  count            Int      @default(1)
  registerAddress  String?  @map("register_address") @db.VarChar(20)
  registerType     String?  @default("coil") @map("register_type") @db.VarChar(20)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("remote_setting_command_master")
}

model DeviceRemoteSetting {
  id               BigInt             @id @default(autoincrement())
  deviceInverterId BigInt             @map("device_inverter_id")
  tab              RemoteSettingsTab
  settings         Json
  updatedById      BigInt?            @map("updated_by_id")
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamp(6)

  @@unique([deviceInverterId, tab], map: "device_remote_settings_device_inverter_id_tab_key")
  @@index([deviceInverterId], map: "device_remote_settings_device_inverter_id_idx")
  @@map("device_remote_settings")
}

model DeviceRemoteSettingTask {
  id               BigInt                   @id @default(autoincrement())
  deviceInverterId BigInt                   @map("device_inverter_id")
  kind             RemoteSettingsTaskKind
  tab              RemoteSettingsTab?
  payload          Json
  status           RemoteSettingsTaskStatus @default(pending)
  createdById      BigInt?                  @map("created_by_id")
  createdAt        DateTime                 @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt        DateTime                 @updatedAt @map("updated_at") @db.Timestamp(6)


  @@index([deviceInverterId], map: "device_remote_setting_tasks_device_inverter_id_idx")
  @@index([status], map: "device_remote_setting_tasks_status_idx")
  @@map("device_remote_setting_tasks")
}

model Firmware {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String    @db.VarChar(255)
  chipType  ChipType? @map("chip_type")
  version   String    @db.VarChar(255)
  remark    String    @default("")
  filePath  String    @map("file_path")
  fileSize  BigInt?   @map("file_size")

  createdById BigInt? @map("created_by")
  createdBy   User?   @relation(fields: [createdById], references: [id])

  createdTime DateTime  @default(now()) @map("created_time") @db.Timestamptz(6)
  updatedTime DateTime  @updatedAt @map("updated_time") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  fotaJobs FotaJob[]

  @@index([name], map: "idx_firmware_name")
  @@index([version], map: "idx_firmware_version")
  @@index([chipType], map: "idx_firmware_chip_type")
  @@map("firmware")
}

model UpgradeTask {
  id   String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name String @db.VarChar(255)

  createdById BigInt? @map("created_by")
  createdBy   User?   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt  DateTime?

  taskJobs TaskJob[]

  @@map("upgrade_task")
}

model TaskJob {
  taskId String @map("task_id") @db.Uuid
  jobId  String @map("job_id") @db.Uuid

  task UpgradeTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  job  FotaJob     @relation(fields: [jobId], references: [jobId])

  @@id([taskId, jobId])
  @@map("task_job")
}

model FotaJob {
  jobId String @id @default(dbgenerated("gen_random_uuid()")) @map("job_id") @db.Uuid

  plantId BigInt @map("plant_id")
  plant   Plant  @relation(fields: [plantId], references: [id])

  loggerImei       String @map("logger_imei") @db.VarChar(20)
  inverterSerialNo String @map("inverter_serial_no") @db.VarChar(50)

  currentFirmware    String? @map("current_firmware") @db.VarChar(255)
  newFirmwareVersion String  @map("new_firmware_version") @db.VarChar(255)

  firmwareId String?   @map("firmware_id") @db.Uuid
  firmware   Firmware? @relation(fields: [firmwareId], references: [id])

  chipType   ChipType
  updateType UpdateType @map("update_type")

  firmwareUrl String @map("firmware_url")

  status FotaJobStatus @default(PENDING)

  failureReason String? @map("failure_reason")

  stepTimeoutSeconds Int      @default(240) @map("step_timeout_seconds")
  stepDeadlineAt     DateTime @map("step_deadline_at") @db.Timestamptz(6)
  
  // New fields
  workerId         String?   @map("worker_id") @db.VarChar(100)
  claimedAt        DateTime? @map("claimed_at") @db.Timestamptz(6)
  lastHeartbeatAt  DateTime? @map("last_heartbeat_at") @db.Timestamptz(6)

  startedById BigInt @map("started_by")
  startedBy   User   @relation(fields: [startedById], references: [id])

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  taskJobs    TaskJob[]
  commandLogs FotaCommandLog[]

  @@index([stepDeadlineAt], map: "idx_fota_job_deadline_watch")
  @@map("fota_job")
}

model FotaConfig {
  id                 Int      @id @default(1) @db.SmallInt
  stepTimeoutSeconds Int      @default(240) @map("step_timeout_seconds")
  updatedAt          DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("fota_config")
}

model FotaCommandLog {
  id BigInt @id @default(autoincrement())

  jobId String  @map("job_id") @db.Uuid
  job   FotaJob @relation(fields: [jobId], references: [jobId], onDelete: Cascade)

  stepSequence Int @map("step_sequence") @db.SmallInt

  commandSent String @map("command_sent")
  rawResponse String? @map("raw_response")

  parsedResult String? @map("parsed_result") @db.VarChar(100)

  status CommandLogStatus @default(PENDING)

  sentAt      DateTime  @default(now()) @map("sent_at") @db.Timestamptz(6)
  respondedAt DateTime? @map("responded_at") @db.Timestamptz(6)

  @@index([jobId], map: "idx_fota_command_log_job_id")
  @@index([status], map: "idx_fota_command_log_status")
  @@map("fota_command_log")
}
